local timeDateLabel = Instance.new("TextLabel", statusBar)
timeDateLabel.Size = UDim2.new(1, -170, 1, 0)
timeDateLabel.Position = UDim2.new(1, -8, 0, 0)
timeDateLabel.AnchorPoint = Vector2.new(1, 0)
timeDateLabel.BackgroundTransparency = 1
timeDateLabel.Text = os.date("%d/%m/%Y | %H:%M:%S")
timeDateLabel.TextColor3 = Color3.fromRGB(240, 240, 240)
timeDateLabel.TextSize = 11
timeDateLabel.Font = Enum.Font.GothamBold
timeDateLabel.TextXAlignment = Enum.TextXAlignment.Right
timeDateLabel.ZIndex = 1002

local frameCount = 0
local lastStatUpdate = tick()
RunService.RenderStepped:Connect(function()
    frameCount += 1
    local now = tick()
    if now - lastStatUpdate >= 0.5 then
        local elapsed = now - lastStatUpdate
        local fps = math.floor((frameCount / elapsed) + 0.5)
        frameCount = 0
        lastStatUpdate = now

        fpsLabel.Text = "FPS: " .. tostring(fps)
        if fps >= 50 then
            fpsLabel.TextColor3 = Color3.fromRGB(0, 255, 100)
        elseif fps >= 30 then
            fpsLabel.TextColor3 = Color3.fromRGB(255, 215, 0)
        else
            fpsLabel.TextColor3 = Color3.fromRGB(255, 65, 65)
        end

        local ping = 0
        pcall(function()
            local dataPing = Stats.Network.ServerStatsItem["Data Ping"]
            if dataPing then ping = math.floor(dataPing:GetValue() + 0.5) end
        end)
        if ping <= 0 then
            pcall(function() ping = math.floor((player:GetNetworkPing() * 1000) + 0.5) end)
        end

        msLabel.Text = "MS: " .. tostring(ping)
        if ping <= 90 then
            msLabel.TextColor3 = Color3.fromRGB(0, 255, 100)
        elseif ping <= 180 then
            msLabel.TextColor3 = Color3.fromRGB(255, 215, 0)
        else
            msLabel.TextColor3 = Color3.fromRGB(255, 65, 65)
        end

        timeDateLabel.Text = os.date("%d/%m/%Y | %H:%M:%S")
    end
end)

