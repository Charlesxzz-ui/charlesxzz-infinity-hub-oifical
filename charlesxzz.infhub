local function addSectionTitle(titleText, order)
    local lbl = Instance.new("TextLabel", textScroll)
    lbl.Size = UDim2.new(1, -10, 0, 24)
    lbl.BackgroundTransparency = 1
    lbl.Text = titleText
    lbl.TextColor3 = Color3.fromRGB(255, 215, 0)
    lbl.TextSize = 15
    lbl.Font = Enum.Font.GothamBlack
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.LayoutOrder = order
    lbl.ZIndex = 2004
    applyTextReadability(lbl, 0.3)
end

local function addBodyText(bodyText, order)
    local lbl = Instance.new("TextLabel", textScroll)
    lbl.Size = UDim2.new(1, -10, 0, 0)
    lbl.AutomaticSize = Enum.AutomaticSize.Y
    lbl.BackgroundTransparency = 1
    lbl.Text = bodyText
    lbl.TextColor3 = Color3.fromRGB(252, 252, 252)
    lbl.TextSize = 13
    lbl.Font = Enum.Font.GothamMedium
    lbl.TextWrapped = true
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.LayoutOrder = order
    lbl.ZIndex = 2004
    applyTextReadability(lbl, 0.45)
end

