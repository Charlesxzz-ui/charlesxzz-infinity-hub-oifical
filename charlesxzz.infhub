-- ==================== CONTROLE DO PAINEL E ARRASTAR ====================
local isOpen = false
local animating = false

local function togglePanel()
    if animating then return end
    animating = true

    isOpen = not isOpen
    if isOpen then
        local targetScale = getTargetScale(CONFIG.PANEL_WIDTH, CONFIG.PANEL_HEIGHT)
        mainPanel.Visible = true
        mainPanelScale.Scale = 0
        TweenService:Create(mainPanelScale, TweenInfo.new(0.28, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = targetScale }):Play()
        closeText.Text = "✕"
        task.wait(0.28)
    else
        TweenService:Create(mainPanelScale, TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Scale = 0 }):Play()
        task.wait(0.22)
        mainPanel.Visible = false
        closeText.Text = ""
    end
    animating = false
end

local dragging = false
local dragStart, startPos
local dragCheck = false

toggleButton.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = toggleButton.Position
        dragCheck = false

        local connection
        connection = input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
                connection:Disconnect()
                if not dragCheck then togglePanel() end
            end
        end)
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        if math.abs(delta.X) > 5 or math.abs(delta.Y) > 5 then dragCheck = true end
        if dragCheck then
            toggleButton.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end
end)

