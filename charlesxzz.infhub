-- Animação RGB global
local hue = 0
local rgbConnection = RunService.RenderStepped:Connect(function(dt)
    hue = (hue + dt * 0.22) % 1
    local softRgbColor = Color3.fromHSV(hue, 0.65, 0.8)
    if loadingStroke and loadingStroke.Parent then
        loadingStroke.Color = softRgbColor
        barFill.BackgroundColor3 = softRgbColor
    end
    if keyStroke and keyStroke.Parent then
        keyStroke.Color = softRgbColor
        verifyStroke.Color = softRgbColor
    end
    if welcomeStroke and welcomeStroke.Parent then
        welcomeStroke.Color = softRgbColor
        proceedStroke.Color = softRgbColor
    end
end)

-- ==================== FLUXO DE ENTRADA ====================
local welcomeClosed = false

local function closeWelcomeScreen()
    if welcomeClosed then return end
    welcomeClosed = true

    if rgbConnection then rgbConnection:Disconnect() end

    TweenService:Create(welcomeOverlay, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { BackgroundTransparency = 1 }):Play()
    TweenService:Create(welcomeScale, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.In), { Scale = 0 }):Play()
    task.wait(0.35)
    welcomeOverlay:Destroy()

    toggleButton.Visible = true
    buttonScale.Scale = 0
    TweenService:Create(buttonScale, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
end

proceedBtn.Activated:Connect(closeWelcomeScreen)

local function openWelcomeScreen()
    welcomeOverlay.Visible = true
    TweenService:Create(welcomeOverlay, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { BackgroundTransparency = 0.25 }):Play()
    TweenService:Create(welcomeScale, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = getTargetScale(CONFIG.WELCOME_WIDTH, CONFIG.WELCOME_HEIGHT) }):Play()

    task.spawn(function()
        local timeLeft = 90
        while timeLeft > 0 and not welcomeClosed do
            local mins = math.floor(timeLeft / 60)
            local secs = timeLeft % 60
            timerLabel.Text = string.format("⏱️ %02d:%02d", mins, secs)
            task.wait(1)
            timeLeft -= 1
        end
        if not welcomeClosed then closeWelcomeScreen() end
    end)
end

task.spawn(function()
    TweenService:Create(loadingOverlay, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { BackgroundTransparency = 0.35 }):Play()
    TweenService:Create(loadingScale, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = getTargetScale(340, 110) }):Play()
    task.wait(0.3)

    local currentValidKey = ""
    local steps = {
        {pct = 0.30, text = "Inicializando interface... 30%"},
        {pct = 0.65, text = "Verificando Key ativa... 65%", checkKey = true},
        {pct = 1.00, text = "Carregamento concluído! 100%"}
    }

    for _, step in ipairs(steps) do
        loadingStatus.Text = step.text
        if step.checkKey then currentValidKey = getActiveKey() end
        TweenService:Create(barFill, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = UDim2.new(step.pct, 0, 1, 0) }):Play()
        task.wait(0.4)
    end

    TweenService:Create(loadingScale, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.In), { Scale = 0 }):Play()
    TweenService:Create(loadingOverlay, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { BackgroundTransparency = 1 }):Play()
    task.wait(0.25)
    loadingOverlay:Destroy()

    local savedKey = ""
    pcall(function()
        if isfile and readfile and isfile(CONFIG.KEY_SAVE_FILE) then
            savedKey = readfile(CONFIG.KEY_SAVE_FILE):gsub("%s+", "")
        end
    end)

    if savedKey ~= "" and savedKey == currentValidKey then
        sendDiscordLog("🔓 Hub Carregado (Key Salva)", "O jogador entrou automaticamente usando uma Key válida já salva.", 3066993)
        openWelcomeScreen()
        return
    end

    keyOverlay.Visible = true
    TweenService:Create(keyOverlay, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { BackgroundTransparency = 0.3 }):Play()
    TweenService:Create(keyScale, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = getTargetScale(CONFIG.PANEL_WIDTH, CONFIG.PANEL_HEIGHT) }):Play()

    getKeyBtn.Activated:Connect(function()
        pcall(function() if setclipboard then setclipboard(CONFIG.DISCORD_LINK) end end)
        keyFeedback.TextColor3 = Color3.fromRGB(100, 220, 255)
        keyFeedback.Text = "✔ LINK COPIADO! PEGUE A KEY LÁ."
    end)

    local keyUnlocked = false
    verifyKeyBtn.Activated:Connect(function()
        if keyUnlocked then return end
        local typed = keyInput.Text:gsub("%s+", "")
        local latestKey = getActiveKey()

        if typed == latestKey and typed ~= "" then
            keyUnlocked = true
            keyFeedback.TextColor3 = Color3.fromRGB(0, 255, 110)
            keyFeedback.Text = "KEY CORRETA, APROVEITE GOAT"
            inputStroke.Color = Color3.fromRGB(0, 255, 110)

            sendDiscordLog("✅ Key Validada com Sucesso", "O jogador inseriu uma Key válida.", 3066993)

            pcall(function()
                if writefile then writefile(CONFIG.KEY_SAVE_FILE, typed) end
            end)

            task.wait(0.8)
            TweenService:Create(keyScale, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.In), { Scale = 0 }):Play()
            TweenService:Create(keyOverlay, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { BackgroundTransparency = 1 }):Play()
            task.wait(0.3)
            keyOverlay:Destroy()

            openWelcomeScreen()
        else
            keyFeedback.TextColor3 = Color3.fromRGB(255, 65, 65)
            keyFeedback.Text = "ACESSO NEGADO"
            inputStroke.Color = Color3.fromRGB(255, 65, 65)

            sendDiscordLog("⛔ Tentativa de Key Inválida", "O jogador tentou acessar com uma Key incorreta.", 15158332)

            task.wait(1.5)
            inputStroke.Color = Color3.fromRGB(120, 120, 120)
        end
    end)
end)
