local function addInfoCard(parentScroll, titleText, bodyText, isDiscord)
    local card = Instance.new("Frame", parentScroll)
    card.Size = UDim2.new(1, -10, 0, 82)
    card.BackgroundColor3 = Color3.fromRGB(16, 16, 16)
    card.BackgroundTransparency = 0.12
    card.BorderSizePixel = 0
    card.ZIndex = 1002

    Instance.new("UICorner", card).CornerRadius = UDim.new(0, 8)
    local cStroke = Instance.new("UIStroke", card)
    cStroke.Color = isDiscord and Color3.fromRGB(88, 101, 242) or Color3.fromRGB(70, 70, 70)
    cStroke.Thickness = 1
    cStroke.Transparency = 0.55

    local tLbl = Instance.new("TextLabel", card)
    tLbl.Size = UDim2.new(1, -24, 0, 24)
    tLbl.Position = UDim2.new(0, 12, 0, 8)
    tLbl.BackgroundTransparency = 1
    tLbl.Text = titleText
    tLbl.TextColor3 = Color3.fromRGB(255, 215, 0)
    tLbl.TextSize = 13
    tLbl.Font = Enum.Font.GothamBold
    tLbl.ZIndex = 1003

    local bLbl = Instance.new("TextLabel", card)
    bLbl.Size = UDim2.new(1, -24, 0, 42)
    bLbl.Position = UDim2.new(0, 12, 0, 32)
    bLbl.BackgroundTransparency = 1
    bLbl.Text = bodyText
    bLbl.TextColor3 = Color3.fromRGB(245, 245, 245)
    bLbl.TextSize = 11
    bLbl.Font = Enum.Font.Gotham
    bLbl.TextWrapped = true
    bLbl.TextXAlignment = Enum.TextXAlignment.Left
    bLbl.ZIndex = 1003

    if isDiscord then
        local copyBtn = Instance.new("TextButton", card)
        copyBtn.Size = UDim2.new(0, 110, 0, 26)
        copyBtn.Position = UDim2.new(1, -122, 0, 8)
        copyBtn.BackgroundColor3 = Color3.fromRGB(88, 101, 242)
        copyBtn.Text = "COPIAR DISCORD"
        copyBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        copyBtn.TextSize = 10
        copyBtn.Font = Enum.Font.GothamBold
        copyBtn.ZIndex = 1004
        Instance.new("UICorner", copyBtn).CornerRadius = UDim.new(0, 6)

        copyBtn.Activated:Connect(function()
            pcall(function()
                if setclipboard then setclipboard(CONFIG.DISCORD_LINK) end
            end)
            copyBtn.Text = "✔ COPIADO!"
            copyBtn.BackgroundColor3 = Color3.fromRGB(0, 180, 90)
            task.wait(2)
            copyBtn.Text = "COPIAR DISCORD"
            copyBtn.BackgroundColor3 = Color3.fromRGB(88, 101, 242)
        end)
    end
end

