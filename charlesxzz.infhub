addScriptExecutor(antPuloTab, "10. ANT PULO MORETI HUB 🌈", "Ant Pulo Moretti", function()
    local p = game.Players.LocalPlayer
    local rs = game:GetService("RunService")
    local g = Instance.new("ScreenGui", game.CoreGui)
    g.ResetOnSpawn = false
    local m = Instance.new("Frame", g)
    m.Size = UDim2.new(0, 270, 0, 180)
    m.Position = UDim2.new(0.5, -135, 0.5, -90)
    m.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
    m.Active = true
    m.Draggable = true
    Instance.new("UICorner", m)
    local t = Instance.new("TextLabel", m)
    t.Size = UDim2.new(1, 0, 0, 40)
    t.Text = "Anti Pulo Moretti"
    t.TextScaled = true
    local function bt(n, y)
        local b = Instance.new("TextButton", m)
        b.Size = UDim2.new(0.9, 0, 0, 40)
        b.Position = UDim2.new(0.05, 0, 0, y)
        b.Text = n
        b.TextScaled = true
        Instance.new("UICorner", b)
        return b
    end
    local a = false
    rs.RenderStepped:Connect(function()
        if a and p.Character and p.Character:FindFirstChild("Humanoid") then
            p.Character.Humanoid.JumpPower = 0
        end
    end)
    local aB = bt(" Anti-Pulo [OFF]", 50)
    aB.MouseButton1Click:Connect(function()
        a = not a
        aB.Text = a and " Anti-Pulo [ON]" or " Anti-Pulo [OFF]"
        if not a and p.Character and p.Character:FindFirstChild("Humanoid") then
            p.Character.Humanoid.JumpPower = 50
        end
    end)
    local oB = bt(" Otimização", 100)
    oB.MouseButton1Click:Connect(function()
        for _, o in pairs(workspace:GetDescendants()) do
            if o:IsA("ParticleEmitter") or o:IsA("Trail") or o:IsA("Smoke") then
                o.Enabled = false
            elseif o:IsA("Decal") then
                o.Transparency = 1
            end
        end
        oB.Text = " Otimização [OK]"
    end)
end)

