local tabs = {}
local activeTabName = nil

local function createTab(tabName, tabEmoji)
    local tabBtn = Instance.new("TextButton", tabsScroll)
    tabBtn.Name = tabName .. "TabBtn"
    tabBtn.Size = UDim2.new(1, 0, 0, 36)
    tabBtn.BackgroundColor3 = Color3.fromRGB(16, 16, 16)
    tabBtn.BackgroundTransparency = 0.15
    tabBtn.BorderSizePixel = 0
    tabBtn.Text = " " .. tabEmoji .. "  " .. tabName
    tabBtn.TextColor3 = Color3.fromRGB(215, 215, 215)
    tabBtn.TextSize = 12
    tabBtn.Font = Enum.Font.GothamBold
    tabBtn.TextXAlignment = Enum.TextXAlignment.Left
    tabBtn.AutoButtonColor = false
    tabBtn.Active = true
    tabBtn.ZIndex = 1001

    Instance.new("UICorner", tabBtn).CornerRadius = UDim.new(0, 8)

    local tabContentScroll = Instance.new("ScrollingFrame", contentContainer)
    tabContentScroll.Name = tabName .. "Content"
    tabContentScroll.Size = UDim2.new(1, 0, 1, 0)
    tabContentScroll.BackgroundTransparency = 1
    tabContentScroll.BorderSizePixel = 0
    tabContentScroll.ScrollBarThickness = 4
    tabContentScroll.ScrollBarImageColor3 = CONFIG.ACCENT_COLOR
    tabContentScroll.CanvasSize = UDim2.new(0, 0, 0, 0)
    tabContentScroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
    tabContentScroll.Visible = false
    tabContentScroll.ZIndex = 1001

    local contentLayout = Instance.new("UIListLayout", tabContentScroll)
    contentLayout.Padding = UDim.new(0, 10)
    contentLayout.SortOrder = Enum.SortOrder.LayoutOrder

    local function selectTab()
        for _, t in pairs(tabs) do
            t.button.BackgroundColor3 = Color3.fromRGB(16, 16, 16)
            t.button.BackgroundTransparency = 0.15
            t.button.TextColor3 = Color3.fromRGB(215, 215, 215)
            t.content.Visible = false
        end
        tabBtn.BackgroundColor3 = Color3.fromRGB(48, 48, 48)
        tabBtn.BackgroundTransparency = 0.08
        tabBtn.TextColor3 = CONFIG.ACCENT_COLOR
        tabContentScroll.Visible = true
        activeTabName = tabName
    end

    tabBtn.Activated:Connect(selectTab)
    tabs[tabName] = { button = tabBtn, content = tabContentScroll }

    if not activeTabName then selectTab() end
    return tabContentScroll
end

local function addScriptExecutor(targetTabScroll, scriptName, description, scriptUrlOrFunc)
    local optionFrame = Instance.new("Frame", targetTabScroll)
    optionFrame.Size = UDim2.new(1, -10, 0, 70)
    optionFrame.BackgroundColor3 = Color3.fromRGB(16, 16, 16)
    optionFrame.BackgroundTransparency = 0.12
    optionFrame.BorderSizePixel = 0
    optionFrame.ZIndex = 1002

    Instance.new("UICorner", optionFrame).CornerRadius = UDim.new(0, 8)
    local optionStroke = Instance.new("UIStroke", optionFrame)
    optionStroke.Color = Color3.fromRGB(70, 70, 70)
    optionStroke.Transparency = 0.65
    optionStroke.Thickness = 1

    local nameLabel = Instance.new("TextLabel", optionFrame)
    nameLabel.Size = UDim2.new(1, -90, 0, 30)
    nameLabel.Position = UDim2.new(0, 12, 0, 8)
    nameLabel.BackgroundTransparency = 1
    nameLabel.Text = scriptName
    nameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    nameLabel.TextSize = 13
    nameLabel.Font = Enum.Font.GothamBold
    nameLabel.TextXAlignment = Enum.TextXAlignment.Left
    nameLabel.ZIndex = 1003

    local descLabel = Instance.new("TextLabel", optionFrame)
    descLabel.Size = UDim2.new(1, -90, 0, 20)
    descLabel.Position = UDim2.new(0, 12, 0, 38)
    descLabel.BackgroundTransparency = 1
    descLabel.Text = description
    descLabel.TextColor3 = Color3.fromRGB(205, 205, 205)
    descLabel.TextSize = 11
    descLabel.Font = Enum.Font.Gotham
    descLabel.TextXAlignment = Enum.TextXAlignment.Left
    descLabel.ZIndex = 1003

    local execBtn = Instance.new("TextButton", optionFrame)
    execBtn.Size = UDim2.new(0, 60, 0, 28)
    execBtn.Position = UDim2.new(1, -72, 0.5, -14)
    execBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 0)
    execBtn.BorderSizePixel = 0
    execBtn.Text = "▶"
    execBtn.TextColor3 = CONFIG.TEXT_COLOR
    execBtn.TextSize = 14
    execBtn.Font = Enum.Font.GothamBold
    execBtn.AutoButtonColor = false
    execBtn.Active = true
    execBtn.ZIndex = 1004

    Instance.new("UICorner", execBtn).CornerRadius = UDim.new(0, 6)

    local lastExec = 0
    execBtn.Activated:Connect(function()
        local now = tick()
        if now - lastExec < 0.5 then return end
        lastExec = now

        execBtn.Text = "..."
        task.spawn(function()
            local ok, err = pcall(function()
                if type(scriptUrlOrFunc) == "function" then
                    scriptUrlOrFunc()
                else
                    loadstring(game:HttpGet(scriptUrlOrFunc))()
                end
            end)
            if ok then
                sendDiscordLog("⚡ Script Executado", string.format("O jogador ativou o script **%s**\nCategoria: `%s`", scriptName, tostring(activeTabName or "N/A")), 5763719)
                execBtn.Text = "✔"
                execBtn.BackgroundColor3 = Color3.fromRGB(0, 200, 100)
                task.wait(1.5)
                execBtn.Text = "▶"
                execBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 0)
            else
                warn("[Infinity Hub] Erro em " .. scriptName .. ": " .. tostring(err))
                execBtn.Text = "❌"
                execBtn.BackgroundColor3 = Color3.fromRGB(200, 0, 0)
                task.wait(1.5)
                execBtn.Text = "▶"
                execBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 0)
            end
        end)
    end)
end

