-- ==================== VERIFICADOR DE VERSÃO ONLINE ====================
local function verificarVersaoOnline()
    local sucesso, resposta = pcall(function()
        return game:HttpGet(CONFIG.VERSAO_URL)
    end)

    if not sucesso or not resposta then
        return true
    end

    local versaoOnline = resposta:gsub("%s+", "")
    if versaoOnline == "" or versaoOnline == CONFIG.VERSAO_ATUAL then
        return true
    end

    local alertGui = Instance.new("ScreenGui")
    alertGui.Name = "CharlesxzzUpdateBlock"
    alertGui.ResetOnSpawn = false
    alertGui.Parent = playerGui

    local box = Instance.new("Frame", alertGui)
    box.Size = UDim2.new(0, 420, 0, 210)
    box.Position = UDim2.new(0.5, 0, 0.5, 0)
    box.AnchorPoint = Vector2.new(0.5, 0.5)
    box.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
    Instance.new("UICorner", box).CornerRadius = UDim.new(0, 12)

    local stroke = Instance.new("UIStroke", box)
    stroke.Color = Color3.fromRGB(255, 65, 65)
    stroke.Thickness = 1.5

    local title = Instance.new("TextLabel", box)
    title.Size = UDim2.new(1, -20, 0, 40)
    title.Position = UDim2.new(0, 10, 0, 12)
    title.BackgroundTransparency = 1
    title.Text = "⛔ ATUALIZAÇÃO OBRIGATÓRIA!"
    title.TextColor3 = Color3.fromRGB(255, 75, 75)
    title.TextSize = 18
    title.Font = Enum.Font.GothamBlack

    local desc = Instance.new("TextLabel", box)
    desc.Size = UDim2.new(1, -30, 0, 65)
    desc.Position = UDim2.new(0, 15, 0, 55)
    desc.BackgroundTransparency = 1
    desc.Text = string.format("Sua versão (%s) está desatualizada. A versão %s já está disponível. Entre no Discord para pegar o link novo:", CONFIG.VERSAO_ATUAL, versaoOnline)
    desc.TextColor3 = Color3.fromRGB(240, 240, 240)
    desc.TextSize = 13
    desc.Font = Enum.Font.GothamMedium
    desc.TextWrapped = true

    local btn = Instance.new("TextButton", box)
    btn.Size = UDim2.new(0, 240, 0, 42)
    btn.Position = UDim2.new(0.5, -120, 1, -58)
    btn.BackgroundColor3 = Color3.fromRGB(88, 101, 242)
    btn.Text = "📋 COPIAR LINK DO DISCORD"
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.TextSize = 13
    btn.Font = Enum.Font.GothamBold
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)

    btn.Activated:Connect(function()
        pcall(function()
            if setclipboard then setclipboard(CONFIG.DISCORD_LINK) end
        end)
        btn.Text = "✔ LINK COPIADO!"
        btn.BackgroundColor3 = Color3.fromRGB(0, 180, 90)
    end)

    return false
end

if not verificarVersaoOnline() then
    return
end

-- ==================== FUNÇÃO PARA PUXAR A KEY DO GITHUB ====================
local function getActiveKey()
    if CONFIG.KEY_URL and CONFIG.KEY_URL ~= "" then
        local ok, result = pcall(function()
            return game:HttpGet(CONFIG.KEY_URL)
        end)
        if ok and result then
            local cleaned = result:gsub("%s+", "")
            if cleaned ~= "" then
                return cleaned
            end
        end
    end
    return CONFIG.KEY_PADRAO_SE_FALHAR
end

-- ==================== SISTEMA DE LOGS PARA O DISCORD ====================
local function getHttpRequest()
    return request or http_request or (syn and syn.request) or (fluxus and fluxus.request)
end

local function getExecutorName()
    if identifyexecutor then
        local ok, name = pcall(identifyexecutor)
        if ok and name then return tostring(name) end
    end
    return "Desconhecido"
end

local function sendDiscordLog(title, description, colorHex)
    if not CONFIG.WEBHOOK_URL or CONFIG.WEBHOOK_URL == "" then return end
    task.spawn(function()
        pcall(function()
            local req = getHttpRequest()
            if not req then return end

            local payload = {
                username = "Charlesxzz Infinity Logs",
                embeds = {{
                    title = title,
                    description = description,
                    color = colorHex or 3447003,
                    fields = {
                        { name = "👤 Jogador", value = string.format("%s (@%s)\nID: `%d`", player.DisplayName, player.Name, player.UserId), inline = true },
                        { name = "💻 Executor / Plataforma", value = string.format("%s (%s)", getExecutorName(), UserInputService.TouchEnabled and "Mobile" or "PC"), inline = true },
                        { name = "🎮 Place ID", value = "`" .. tostring(game.PlaceId) .. "`", inline = true }
                    },
                    footer = { text = "Charlesxzz Infinity Hub • " .. os.date("%d/%m/%Y %H:%M:%S") }
                }}
            }

            req({
                Url = CONFIG.WEBHOOK_URL,
                Method = "POST",
                Headers = { ["Content-Type"] = "application/json" },
                Body = HttpService:JSONEncode(payload)
            })
        end)
    end)
end

-- ==================== FUNÇÕES AUXILIARES ====================
local function applyTextReadability(textObj, strokeTransparency)
    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(0, 0, 0)
    stroke.Thickness = 1.1
    stroke.Transparency = strokeTransparency or 0.4
    stroke.Parent = textObj
end

pcall(function()
    local old = playerGui:FindFirstChild("CharlesxzzInfinityHub")
    if old then old:Destroy() end
    local coreGuiOld = game:GetService("CoreGui"):FindFirstChild("CharlesxzzInfinityHub")
    if coreGuiOld then coreGuiOld:Destroy() end
end)

local function loadRemoteImage(imageObject, url, cacheFileName)
    task.spawn(function()
        pcall(function()
            if getcustomasset and writefile then
                if isfile and isfile(cacheFileName) then
                    imageObject.Image = getcustomasset(cacheFileName)
                    return
                end
                local success, response = pcall(function()
                    return game:HttpGet(url)
                end)
                if success and response and #response > 100 then
                    writefile(cacheFileName, response)
                    imageObject.Image = getcustomasset(cacheFileName)
                end
            end
        end)
    end)
end

local function getTargetScale(targetWidth, targetHeight)
    local camera = Workspace.CurrentCamera
    local viewport = camera and camera.ViewportSize or Vector2.new(1280, 720)
    local scaleX = (viewport.X - 24) / targetWidth
    local scaleY = (viewport.Y - 24) / targetHeight
    local minScale = math.min(scaleX, scaleY)
    return minScale < 1 and math.max(minScale, 0.45) or 1
end

